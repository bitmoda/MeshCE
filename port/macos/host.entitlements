<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The native loader copies its locally compiled ARM image into memory
         and makes its code pages executable. A Developer ID release needs
         this. An ad hoc local build does not get this file: that signature
         cannot carry a restricted entitlement, and macOS then refuses to
         open the app. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
